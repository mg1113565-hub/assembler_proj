{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build project",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Iinclude",
                "${workspaceFolder}/src/HackAssembler.cpp",
                "${workspaceFolder}/src/Code.cpp",
                "${workspaceFolder}/src/Parser.cpp",
                "${workspaceFolder}/src/SymbolTable.cpp",
                "-o",
                "${workspaceFolder}/src/HackAssembler"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}